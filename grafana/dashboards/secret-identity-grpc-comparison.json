{
  "uid": "secret-identity-a2-comparison",
  "title": "Secret Identity — HTTP vs gRPC",
  "description": "Same game, two protocols: volume, errors, latency, in-flight, and payload size",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["secret-identity", "assignment2", "grpc"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP: Request Volume by Route (req/s)",
      "description": "HTTP request throughput by route template",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[1m]))",
          "legendFormat": "HTTP {{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "gRPC: Call Volume by RPC Method (calls/s)",
      "description": "gRPC call throughput by RPC method",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grpc_method) (rate(grpc_server_handled_total[1m]))",
          "legendFormat": "gRPC {{grpc_method}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP: Non-2xx Errors by Status Code (errors/s)",
      "description": "Failed HTTP requests (4xx and 5xx responses)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(http_requests_total{status_code!~\"2..\"}[1m]))",
          "legendFormat": "HTTP {{status_code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "gRPC: Error Rate by Method and Status (errors/s)",
      "description": "Failed gRPC calls (non-OK status codes: INVALID_ARGUMENT, NOT_FOUND, etc.)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grpc_method, grpc_code) (rate(grpc_server_handled_total{grpc_code!=\"OK\"}[1m]))",
          "legendFormat": "gRPC {{grpc_method}} [{{grpc_code}}]"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP: Duration Quantiles (p50 & p95 over 5m window)",
      "description": "HTTP request duration quantiles measured at server middleware",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "HTTP {{route}} (p50)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "HTTP {{route}} (p95)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "gRPC: Server Duration Quantiles (p50 & p95 over 5m window)",
      "description": "gRPC execution duration quantiles measured at server method dispatcher",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, grpc_method) (rate(grpc_server_handling_seconds_bucket[5m])))",
          "legendFormat": "gRPC {{grpc_method}} (p50)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, grpc_method) (rate(grpc_server_handling_seconds_bucket[5m])))",
          "legendFormat": "gRPC {{grpc_method}} (p95)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP: Rate Limit (429) & Idempotency Hits",
      "description": "HTTP rate limit rejections and safe idempotency cache hits",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_rate_limit_hits_total[1m]))",
          "legendFormat": "429 Rate Limited {{route}}"
        },
        {
          "refId": "B",
          "expr": "sum by (route) (rate(http_idempotency_hits_total[1m]))",
          "legendFormat": "Idempotent Replay {{route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "gRPC: In-Flight Calls & Idempotency Cache Hits",
      "description": "Active concurrent gRPC calls per method and idempotency cache hit rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grpc_method) (grpc_server_in_flight_requests)",
          "legendFormat": "In-flight {{grpc_method}}"
        },
        {
          "refId": "B",
          "expr": "sum by (grpc_method) (rate(grpc_idempotency_hits_total[1m]))",
          "legendFormat": "Replay Cache Hits {{grpc_method}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "gRPC: Message Payload Size Distribution (p95 bytes)",
      "description": "p95 size in bytes of sent and received Protobuf messages",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, grpc_method) (rate(grpc_server_msg_received_bytes_bucket[5m])))",
          "legendFormat": "Received Bytes p95 ({{grpc_method}})"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, grpc_method) (rate(grpc_server_msg_sent_bytes_bucket[5m])))",
          "legendFormat": "Sent Bytes p95 ({{grpc_method}})"
        }
      ]
    }
  ]
}
