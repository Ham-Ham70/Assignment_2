{
  "uid": "secret-identity-node",
  "title": "Secret Identity — Node Exporter (docker-desktop-linux-vm)",
  "description": "Host/VM metrics from Node Exporter. Machine label: docker-desktop-linux-vm",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["secret-identity", "node-exporter"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (machine) (rate(node_cpu_seconds_total{mode=\"idle\",machine=\"docker-desktop-linux-vm\"}[1m])) * 100)",
          "legendFormat": "{{machine}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory available / total",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{machine=\"docker-desktop-linux-vm\"}",
          "legendFormat": "available"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemTotal_bytes{machine=\"docker-desktop-linux-vm\"}",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk free (root filesystem)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{machine=\"docker-desktop-linux-vm\",mountpoint=\"/\"}",
          "legendFormat": "avail {{mountpoint}}"
        },
        {
          "refId": "B",
          "expr": "node_filesystem_size_bytes{machine=\"docker-desktop-linux-vm\",mountpoint=\"/\"}",
          "legendFormat": "size {{mountpoint}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network receive / transmit",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{machine=\"docker-desktop-linux-vm\",device!~\"lo|veth.*|br.*|docker.*\"}[1m]))",
          "legendFormat": "rx {{device}}"
        },
        {
          "refId": "B",
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{machine=\"docker-desktop-linux-vm\",device!~\"lo|veth.*|br.*|docker.*\"}[1m]))",
          "legendFormat": "tx {{device}}"
        }
      ]
    }
  ]
}
